# Separate Railway service; do NOT commit a .env with real credentials
NODE_ENV=production
PORT=8080
WEB_ORIGIN=https://app.rimmaapp.com
RIMMA_API_BASE_URL=https://rimma-server-production.up.railway.app
# DO NOT enable ALLOW_HTTP_UPSTREAM in production.

# Optional managed anti-bot protection. Configure both to enable Cloudflare Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
