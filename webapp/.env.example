# RIMMA web application environment
# Copy locally only when needed. Never commit a populated .env file.

NODE_ENV=production
PORT=8080

# Exact public origin of the authenticated web portal; no trailing slash.
WEB_ORIGIN=https://app.rimmaapp.com

# HTTPS URL of the RIMMA core backend.
RIMMA_API_BASE_URL=https://rimma-server-production.up.railway.app

# Public login is an explicit production feature flag.
WEB_PUBLIC_LOGIN_ENABLED=false

# Production web sessions. Configure both database and current key together.
# WEB_SESSION_KEY_BASE64 must be 32 random bytes encoded as base64.
WEB_SESSION_DATABASE_URL=
WEB_SESSION_KEY_BASE64=

# Optional comma-separated previous session keys during controlled key rotation.
WEB_SESSION_OLD_KEYS_BASE64=

# Optional managed anti-bot protection. Configure both values to enable it.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web checkout is independently gated from login.
WEB_BILLING_CHECKOUT_ENABLED=false
REVENUECAT_WEB_PURCHASE_LINK=

# Development escape hatch only. Never enable in production.
ALLOW_HTTP_UPSTREAM=false
